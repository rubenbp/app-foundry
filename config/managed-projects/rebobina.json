{
  "id": "rebobina",
  "repository": "rubenbp/appfoundry-site-demo",
  "baseBranch": "main",
  "instructions": ["AGENTS.md", "README.md"],
  "toolchain": {
    "node": "24.21.0",
    "pnpm": "12.14.0",
    "nodeVersionFile": ".node-version",
    "lockfile": "pnpm-lock.yaml"
  },
  "preparation": {
    "command": "pnpm install --frozen-lockfile",
    "requirements": [
      "Node 24.21.0",
      "pnpm 12.14.0",
      "Python 3",
      "Chrome or Playwright Chromium"
    ]
  },
  "verification": {
    "commands": [
      "pnpm build",
      "pnpm lint",
      "pnpm typecheck",
      "pnpm test:unit",
      "pnpm test:e2e"
    ],
    "e2e": {
      "command": "pnpm test:e2e",
      "configFile": "playwright.config.mjs",
      "serverCommand": "python3 -m http.server 4173 --bind 127.0.0.1 --directory dist",
      "origin": "http://127.0.0.1:4173",
      "serves": "dist",
      "reuseExistingServer": false,
      "offline": false
    }
  },
  "publication": {
    "provider": "vercel",
    "teamId": "team_lO097zw1T7irxaAeicmM02ne",
    "projectId": "prj_xELrnqlWcsy0MNKqyZN2Dekd0PKE",
    "projectName": "appfoundry-site-demo",
    "previewEnvironment": "Preview",
    "productionEnvironment": "Production",
    "productionOrigin": "https://rebobina-appfoundry.vercel.app",
    "versionPath": "/version.json",
    "commitVariable": "VERCEL_GIT_COMMIT_SHA",
    "requiredStatusCheck": "Vercel",
    "requireUpToDateBranch": true,
    "humanMergeRequired": true
  }
}
