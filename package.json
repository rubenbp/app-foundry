{
  "name": "app-foundry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": { "node": "24.21.0" },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "start": "node --experimental-strip-types src/cli.ts",
    "experiment": "node --experimental-strip-types scripts/experiment.ts"
  },
  "dependencies": {
    "@opencode-ai/sdk": "1.19.3",
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "opencode-ai": "1.19.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
