{
  "name": "app-foundry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "prototype": "vite --config vite.prototype.config.ts --open '/?variant=A&replay=1'",
    "build": "vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "test:opencode": "node --experimental-strip-types scripts/testOpenCode.ts",
    "test": "npm run test:unit && npm run test:e2e",
    "start": "node --experimental-strip-types src/cli.ts",
    "experiment": "node --experimental-strip-types scripts/experiment.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@opencode/cli": "2.0.32",
    "@opencode/client": "2.0.32",
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "8.3.4"
  }
}
